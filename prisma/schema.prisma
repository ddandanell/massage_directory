datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// User authentication and roles
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  freelancerProfile FreelancerProfile?

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Massage treatment encyclopedia
model Treatment {
  id                    String   @id @default(cuid())
  name                  String   @unique
  slug                  String   @unique
  aliases               String[] // Alternative names
  description           String   @db.Text
  origin                String?
  techniques            String   @db.Text
  durationOptions       Int[] // In minutes
  benefits              String   @db.Text
  contraindications     String   @db.Text
  priceRangeGlobalMin   Int? // In USD cents
  priceRangeGlobalMax   Int?
  priceRangeIndonesiaMin Int? // In IDR
  priceRangeIndonesiaMax Int?
  whoShouldBook         String   @db.Text
  whoShouldNotBook      String   @db.Text
  category              String? // Swedish, Thai, Deep Tissue, etc.
  isPublished           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  services          Service[]
  relatedTreatments TreatmentRelation[] @relation("TreatmentRelations")
  relatedFrom       TreatmentRelation[] @relation("RelatedTreatments")

  @@index([slug])
  @@index([category])
  @@map("treatments")
}

// Self-referential many-to-many for related treatments
model TreatmentRelation {
  id               String    @id @default(cuid())
  treatmentId      String
  relatedTreatmentId String
  treatment        Treatment @relation("TreatmentRelations", fields: [treatmentId], references: [id], onDelete: Cascade)
  relatedTreatment Treatment @relation("RelatedTreatments", fields: [relatedTreatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, relatedTreatmentId])
  @@map("treatment_relations")
}

// Location pages (cities, towns, areas)
model Location {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  region          String // Bali, Java, etc.
  description     String   @db.Text
  massageCulture  String   @db.Text
  latitude        Float?
  longitude       Float?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  freelancers FreelancerProfile[]

  @@index([slug])
  @@index([region])
  @@map("locations")
}

// Freelancer profiles
model FreelancerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String // Brand name or personal name
  slug        String   @unique
  bio         String   @db.Text
  experience  String   @db.Text
  photos      String[] // URLs to uploaded photos
  locationId  String
  availability String? @db.Text
  contactPhone String?
  contactEmail String?
  contactWhatsApp String?
  status      ProfileStatus @default(PENDING)
  rejectionReason String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])
  services Service[]

  @@index([slug])
  @@index([locationId])
  @@index([status])
  @@map("freelancer_profiles")
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

// Junction table: Freelancer offers Treatment at custom price
model Service {
  id                String   @id @default(cuid())
  freelancerProfileId String
  treatmentId       String
  customPricing     Int? // In IDR, overrides treatment default
  durationMinutes   Int?
  customDescription String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  treatment         Treatment         @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, treatmentId])
  @@index([treatmentId])
  @@map("services")
}

// Admin notifications and alerts
model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  metadata  Json? // Flexible data storage
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  PROFILE_PENDING
  CONTENT_QUALITY_ALERT
  PRICING_ANOMALY
  SYSTEM_ALERT
}
